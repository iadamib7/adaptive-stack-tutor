      <text>
/*
Shared Question Bank
Linear Relations
QLIN-04

The first relation is displayed in
slope-intercept form:

y = m1*x + c1

The second relation is displayed in
standard-like form:

a2*x + z = b2

Internally:

a2 = -m2
b2 = c2

so that:

z = m2*x + c2
*/


/*
First relation.
*/

m1:rand_with_prohib(
    -4,
    4,
    [0]
);

c1:rand(9)-4;


/*
Second relation.

Choose a distinct non-zero slope.
*/

m2:rand_with_prohib(
    -4,
    4,
    [0,m1]
);


/*
Shared x-values.
*/

x1:-2;
x2:-1;
x3:1;
x4:2;


/*
Choose c2 so that the two relations
do not produce the same output at any
x-value used in this table.

For an intersection at x:

m1*x+c1 = m2*x+c2

therefore the forbidden c2 value is:

c1+(m1-m2)*x
*/

c2:rand_with_prohib(
    -4,
    4,
    [
        c1+(m1-m2)*x1,
        c1+(m1-m2)*x2,
        c1+(m1-m2)*x3,
        c1+(m1-m2)*x4
    ]
);


/*
Alternative representation of the
second relation.

a2*x + z = b2

is equivalent to

z = m2*x + c2.
*/

a2:-m2;
b2:c2;


/*
First relation outputs.
*/

y1:m1*x1+c1;
y2:m1*x2+c1;
y3:m1*x3+c1;
y4:m1*x4+c1;


/*
Second relation outputs.
*/

z1:m2*x1+c2;
z2:m2*x2+c2;
z3:m2*x3+c2;
z4:m2*x4+c2;


/*
Diagnostic wrong answers.

For y-row cells:
student incorrectly uses the second
relation.

For z-row cells:
student incorrectly uses the first
relation.
*/

wrong1:m2*x2+c2;
wrong2:m2*x3+c2;

wrong3:b2+a2*x1;
wrong4:b2+a2*x4;
      </text>
    </questionvariables>


