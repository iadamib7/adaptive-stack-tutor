  <question type="stack">
    <name>
      <text>Shared: Table to graph simultaneous-equations mastery</text>
    </name>
    <questiontext format="html">
      <text>

&lt;p&gt;
This activity brings together the
main ideas from the linear-relations
progression.
&lt;/p&gt;

&lt;p&gt;
Consider the two relations
&lt;/p&gt;

\[
\text{Relation A: }
y={@m1@}x+({@c1@})
\]

\[
\text{Relation B: }
y={@m2@}x+({@c2@})
\]

&lt;p&gt;
First complete the missing values in
the two tables.
&lt;/p&gt;

&lt;p&gt;
&lt;strong&gt;Relation A&lt;/strong&gt;
&lt;/p&gt;

&lt;table border="1"
cellpadding="8"&gt;

&lt;tr&gt;
&lt;th&gt;x&lt;/th&gt;
&lt;th&gt;-2&lt;/th&gt;
&lt;th&gt;0&lt;/th&gt;
&lt;th&gt;2&lt;/th&gt;
&lt;/tr&gt;

&lt;tr&gt;
&lt;th&gt;y&lt;/th&gt;

&lt;td&gt;
[[input:ans1]]
[[validation:ans1]]
[[feedback:prt1]]
&lt;/td&gt;

&lt;td&gt;
{@a2@}
&lt;/td&gt;

&lt;td&gt;
[[input:ans2]]
[[validation:ans2]]
[[feedback:prt2]]
&lt;/td&gt;

&lt;/tr&gt;
&lt;/table&gt;


&lt;p&gt;
&lt;strong&gt;Relation B&lt;/strong&gt;
&lt;/p&gt;

&lt;table border="1"
cellpadding="8"&gt;

&lt;tr&gt;
&lt;th&gt;x&lt;/th&gt;
&lt;th&gt;-2&lt;/th&gt;
&lt;th&gt;0&lt;/th&gt;
&lt;th&gt;2&lt;/th&gt;
&lt;/tr&gt;

&lt;tr&gt;
&lt;th&gt;y&lt;/th&gt;

&lt;td&gt;
[[input:ans3]]
[[validation:ans3]]
[[feedback:prt3]]
&lt;/td&gt;

&lt;td&gt;
{@b2@}
&lt;/td&gt;

&lt;td&gt;
[[input:ans4]]
[[validation:ans4]]
[[feedback:prt4]]
&lt;/td&gt;

&lt;/tr&gt;
&lt;/table&gt;


&lt;p&gt;
Now construct both relations on the
same Cartesian plane.

Use \(A_1,A_2\) for Relation A and
\(B_1,B_2\) for Relation B.
&lt;/p&gt;

&lt;center&gt;

[[jsxgraph
input-ref-ans5="sA1"
input-ref-ans6="sA2"
input-ref-ans7="sB1"
input-ref-ans8="sB2"]]

JXG.Options.text.useMathJax = true;

var board = JXG.JSXGraph.initBoard(
    divid,
    {
        axis: true,
        showCopyright: false,
        boundingbox: [-6,6,6,-6],
        keepaspectratio: true,
        grid: true
    }
);


var a1 = board.create(
    'point',
    [
        {#start_ax1#},
        {#start_ay1#}
    ],
    {
        name:'A1',
        snapToGrid:true,
        size:3,
        snapSizeX:0.1,
        snapSizeY:0.1,
        showInfobox:false
    }
);


var a2 = board.create(
    'point',
    [
        {#start_ax2#},
        {#start_ay2#}
    ],
    {
        name:'A2',
        snapToGrid:true,
        size:3,
        snapSizeX:0.1,
        snapSizeY:0.1,
        showInfobox:false
    }
);


var lineA = board.create(
    'line',
    [
        a1,
        a2
    ],
    {
        fixed:true,
        straightFirst:true,
        straightLast:true,
        strokeWidth:2
    }
);


var b1 = board.create(
    'point',
    [
        {#start_bx1#},
        {#start_by1#}
    ],
    {
        name:'B1',
        snapToGrid:true,
        size:3,
        snapSizeX:0.1,
        snapSizeY:0.1,
        showInfobox:false
    }
);


var b2 = board.create(
    'point',
    [
        {#start_bx2#},
        {#start_by2#}
    ],
    {
        name:'B2',
        snapToGrid:true,
        size:3,
        snapSizeX:0.1,
        snapSizeY:0.1,
        showInfobox:false
    }
);


var lineB = board.create(
    'line',
    [
        b1,
        b2
    ],
    {
        fixed:true,
        straightFirst:true,
        straightLast:true,
        strokeWidth:2,
        dash:2
    }
);


stack_jxg.bind_point(
    sA1,
    a1
);

stack_jxg.bind_point(
    sA2,
    a2
);

stack_jxg.bind_point(
    sB1,
    b1
);

stack_jxg.bind_point(
    sB2,
    b2
);


board.unsuspendUpdate();

[[/jsxgraph]]

&lt;/center&gt;


