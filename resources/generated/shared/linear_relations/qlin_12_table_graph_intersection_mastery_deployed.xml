      <text>
/*
Shared Curriculum-Independent
Question Bank

Linear Relations
QLIN-12

Final integrated mastery activity.

Verified open-source bases:

NUMBAS-17290
CC BY 4.0
Straight-line graph construction.

NUMBAS-17144
CC BY 4.0
Simultaneous-equation structure.

NUMBAS-40889
CC BY 4.0
Simultaneous-equation solution
reference.
*/


/*
Choose a small intersection first.

x is non-zero.

y differs from x so a reversed
ordered pair remains detectable.
*/

xI:rand_with_prohib(
    -1,
    1,
    [0]
);

yI:rand_with_prohib(
    -2,
    2,
    [xI]
);


/*
Generate two different,
non-horizontal gradients.
*/

m1:rand_with_prohib(
    -2,
    2,
    [0]
);

m2:rand_with_prohib(
    -2,
    2,
    [0,m1]
);


/*
Construct both intercepts so the
relations meet at the selected
intersection.
*/

c1:yI-m1*xI;

c2:yI-m2*xI;


/*
Equations supplied to the learner.
*/

equation1:y=m1*x+c1;

equation2:y=m2*x+c2;


/*
Table x-values.
*/

x1:-2;

x2:0;

x3:2;


/*
Relation A table.
*/

a1:m1*x1+c1;

a2:m1*x2+c1;

a3:m1*x3+c1;


/*
Relation B table.
*/

b1:m2*x1+c2;

b2:m2*x2+c2;

b3:m2*x3+c2;


/*
Wrong-relation diagnostics.

At each missing location, use the
other equation.
*/

wrongA1:m2*x1+c2;

wrongA3:m2*x3+c2;

wrongB1:m1*x1+c1;

wrongB3:m1*x3+c1;


/*
Teacher graph points.

Any two distinct points on the
correct relation are accepted by
the graph PRTs.
*/

ta1:[0,c1];

ta2:[1,m1+c1];

tb1:[0,c2];

tb2:[1,m2+c2];


/*
Intersection and final solution.
*/

intersection:[xI,yI];

reversed:[yI,xI];

solution:[xI,yI];


/*
Initial draggable locations.
*/

start_ax1:-5;

start_ay1:5;

start_ax2:-4;

start_ay2:4;

start_bx1:4;

start_by1:4;

start_bx2:5;

start_by2:5;
      </text>
