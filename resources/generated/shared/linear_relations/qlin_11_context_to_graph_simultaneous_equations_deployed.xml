        <text>
/*
Distance between the two A points.
A single duplicated point must not
define a line.
*/

distA:
    (ans3[1]-ans4[1])^2
    +
    (ans3[2]-ans4[2])^2;


/*
Residuals against Relation A.
Both draggable points must lie on
the required line.
*/

resA1:
    ans3[2]
    -
    (mA*ans3[1]+bA);

resA2:
    ans4[2]
    -
    (mA*ans4[1]+bA);

errorA:
    resA1^2
    +
    resA2^2;


/*
Swapped-line diagnostic:
A points were placed on Relation B.
*/

swapA1:
