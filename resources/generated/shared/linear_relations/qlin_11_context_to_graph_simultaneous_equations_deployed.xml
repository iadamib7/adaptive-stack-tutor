<quiz>
  <question type="stack">
    <name>
      <text>Shared: Model and solve two plans graphically</text>
    </name>
    <questiontext format="html">
      <text>

&lt;p&gt;
Two service plans charge according
to the number of service units used.
&lt;/p&gt;

&lt;p&gt;
&lt;strong&gt;Plan A&lt;/strong&gt;
has a fixed fee of \({@bA@}\)
credits and charges \({@mA@}\)
credits per service unit.
&lt;/p&gt;

&lt;p&gt;
&lt;strong&gt;Plan B&lt;/strong&gt;
has a fixed fee of \({@bB@}\)
credits and charges \({@mB@}\)
credit per service unit.
&lt;/p&gt;

&lt;p&gt;
Let \(x\) represent the number of
service units and \(y\) represent
the total cost.
&lt;/p&gt;

&lt;p&gt;
First write the equation for each
plan.

Enter only the expression on the
right-hand side of \(y=\).
&lt;/p&gt;

&lt;p&gt;
&lt;strong&gt;Plan A:&lt;/strong&gt;

\(y=\)

[[input:ans1]]
[[validation:ans1]]

[[feedback:prt1]]
&lt;/p&gt;

&lt;p&gt;
&lt;strong&gt;Plan B:&lt;/strong&gt;

\(y=\)

[[input:ans2]]
[[validation:ans2]]

[[feedback:prt2]]
&lt;/p&gt;

&lt;p&gt;
Now use \(A_1,A_2\) to graph
Plan A and \(B_1,B_2\) to graph
Plan B.
&lt;/p&gt;

&lt;center&gt;

[[jsxgraph
input-ref-ans3="sA1"
input-ref-ans4="sA2"
input-ref-ans5="sB1"
input-ref-ans6="sB2"]]

JXG.Options.text.useMathJax = true;

var board = JXG.JSXGraph.initBoard(
    divid,
    {
        axis: true,
        showCopyright: false,
        boundingbox: [-1,15,6,-1],
        keepaspectratio: true,
        grid: true
    }
);


var a1 = board.create(
    'point',
    [
        {#start_ax1#},
        {#start_ay1#}
    ],
    {
        name:'A1',
        snapToGrid:true,
        size:3,
        snapSizeX:0.1,
        snapSizeY:0.1,
        showInfobox:false
    }
);


var a2 = board.create(
    'point',
    [
        {#start_ax2#},
        {#start_ay2#}
    ],
    {
        name:'A2',
        snapToGrid:true,
        size:3,
        snapSizeX:0.1,
        snapSizeY:0.1,
        showInfobox:false
    }
);


var lineA = board.create(
    'line',
    [
        a1,
        a2
    ],
    {
        fixed:true,
        straightFirst:true,
        straightLast:true,
        strokeWidth:2
    }
);


var b1 = board.create(
    'point',
    [
        {#start_bx1#},
        {#start_by1#}
    ],
    {
        name:'B1',
        snapToGrid:true,
        size:3,
        snapSizeX:0.1,
        snapSizeY:0.1,
        showInfobox:false
    }
);


var b2 = board.create(
    'point',
    [
        {#start_bx2#},
        {#start_by2#}
    ],
    {
        name:'B2',
        snapToGrid:true,
        size:3,
        snapSizeX:0.1,
        snapSizeY:0.1,
        showInfobox:false
    }
);


var lineB = board.create(
    'line',
    [
        b1,
        b2
    ],
    {
        fixed:true,
        straightFirst:true,
        straightLast:true,
        strokeWidth:2,
        dash:2
    }
);


stack_jxg.bind_point(
    sA1,
    a1
);

stack_jxg.bind_point(
    sA2,
    a2
);

stack_jxg.bind_point(
    sB1,
    b1
);

stack_jxg.bind_point(
    sB2,
    b2
);


board.unsuspendUpdate();

[[/jsxgraph]]

