    <questionvariables>
      <text>
/*
Shared Question Bank
Place Value, Rounding and Standard Form
PVRS-12

Mastery task:
integrate place-value rounding,
significant-figure rounding,
and standard form.

Reference-only interaction sources:
NUMBAS-21514
NUMBAS-169559
NUMBAS-10751

This STACK question is independently
authored. No source wording or mathematical
content is copied.
*/


/*
Generate a six-digit whole number with
three significant digits and trailing
zeros.

This keeps standard-form conversion exact
and lets the same value support all parts.
*/

d1:
    rand_with_prohib(1,8,[]);

d2:
    rand_with_prohib(0,8,[]);

d3:
    rand_with_prohib(5,9,[]);

number:
    d1*100000
    + d2*10000
    + d3*1000;


/*
Part (a):
round to nearest ten thousand.

Because d3 is at least 5, this always
requires rounding upward.
*/

place_value:
    10000;

place_name:
    "ten thousand";

answer_round:
    floor(
        (
            number
            + place_value/2
        )
        / place_value
    )
    * place_value;


/*
Part (b):
round to two significant figures.

For a six-digit number, this is also
rounding to the nearest ten thousand.
*/

sf_count:
    2;

answer_sf:
    answer_round;


/*
Part (c):
standard form.
*/

coefficient:
    d1
    + d2/10
    + d3/100;

exponent:
    5;

coefficient_display:
    float(coefficient);


/*
Diagnostic misconceptions.
*/


/*
Misconception 1:
truncate instead of round.
*/

wrong_truncate:
    floor(
        number/place_value
    )
    * place_value;


/*
Misconception 2:
use three significant figures instead of
two, leaving the original number unchanged.
*/

wrong_sf_count:
    number;


/*
Misconception 3:
invalid standard-form coefficient that is
ten times too large with exponent one too
small.
*/

wrong_coefficient:
    coefficient*10;

wrong_exponent:
    exponent-1;
      </text>
    </questionvariables>


