    <questionvariables>
      <text>
/*
Ghana Basic 9 Mathematics
B9.2.1.1.1
LR-01

Choose a non-zero integer gradient and
an integer intercept.
*/

m: rand_with_prohib(-4,4,[0]);
c: rand(11)-5;

/*
Use fixed x-values so the cognitive demand
is evaluating the relation rather than
decoding the table.
*/

x1:-2;
x2:-1;
x3:0;
x4:1;
x5:2;

/*
Teacher answers.
*/

y1:m*x1+c;
y2:m*x2+c;
y3:m*x3+c;
y4:m*x4+c;
y5:m*x5+c;

/*
Common misconception:
learner ignores the intercept.
*/

wrong1:m*x1;
wrong2:m*x2;
wrong3:m*x3;
wrong4:m*x4;
wrong5:m*x5;
      </text>
    </questionvariables>


